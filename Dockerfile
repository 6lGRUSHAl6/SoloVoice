# Используем официальный образ Python 3.11-slim
FROM python:3.11-slim

# ============================================================================
# Установка системных зависимостей
# ============================================================================
# libffi-dev и libsodium-dev необходимы для PyNaCl (голосовые функции)
# gcc требуется для компиляции некоторых пакетов

RUN apt-get update && apt-get install -y \
    libffi-dev \
    libsodium-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# Подготовка рабочей директории
# ============================================================================

WORKDIR /app

# ============================================================================
# Установка зависимостей Python
# ============================================================================

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ============================================================================
# Копирование кода приложения
# ============================================================================

COPY main.py .
COPY config.py .
COPY cogs/ ./cogs/
COPY utils/ ./utils/

# ============================================================================
# Запуск приложения
# ============================================================================
# -u флаг отключает буферизацию для реального времени логирования

CMD ["python", "-u", "main.py"]
